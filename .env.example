# --- Server ---
PORT=4000
# Bind to localhost only: the harness can run commands in your repos. Do not expose it.
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/agentic-harness
# Where cloned repos and per-run git worktrees live.
DATA_DIR=./data

# --- Providers (only the ones you use) ---
ANTHROPIC_API_KEY=
# Google Gemini: a free key from Google AI Studio works (Flash / Flash-Lite models).
# Free-tier prompts may be used by Google to improve its products: use test/personal repos only.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, Azure proxy...)
OPENAI_BASE_URL=

# --- Git hosting (referenced by name from a repo's "Token env var" field) ---
GITHUB_TOKEN=
